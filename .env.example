# Postgres de desarrollo: `npm run db:up` (Docker, puerto 5433)
# La app se conecta con el rol app_user (sin BYPASSRLS)
DATABASE_URL=postgres://app_user:app_user_dev@localhost:5433/hablahora
# Las migraciones corren con el dueño del esquema
DATABASE_ADMIN_URL=postgres://postgres:postgres_dev@localhost:5433/hablahora
# Better Auth (usuarios de las consolas): rol auth_user, solo ve el esquema auth
AUTH_DATABASE_URL=postgres://auth_user:auth_user_dev@localhost:5433/hablahora
BETTER_AUTH_SECRET=cambia-esto-por-32-caracteres-al-azar   # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:5174          # orígenes de las consolas, separados por coma
CONSOLE_URL=http://localhost:5174              # consola: enlaces de invitación y de contraseña
CHAT_PUBLIC_URL=http://localhost:5173          # base del chat público (enlace y código para incrustar)

# Chat web: límites
CHAT_MAX_MESSAGES_PER_SESSION=60
CHAT_SESSIONS_PER_IP_PER_HOUR=20

# Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5   # o claude-haiku-5-5 para bajar costo
CLAUDE_EFFORT=                   # low | medium | high; vacío = el valor por defecto del modelo

# WhatsApp Cloud API (app de Meta). Apagado en la v1: se activa solo si están
# WA_APP_SECRET, WA_VERIFY_TOKEN y WA_ACCESS_TOKEN.
WA_APP_SECRET=                   # App Secret: valida la firma de cada webhook
WA_VERIFY_TOKEN=                 # el mismo que pones al suscribir el webhook en Meta
WA_ACCESS_TOKEN=                 # token de sistema; con Embedded Signup, uno por negocio
WA_GRAPH_VERSION=v23.0           # revisa la versión vigente en la documentación de Meta

PORT=3000

# ---------- Producción (en desarrollo no hacen falta) ----------
# NODE_ENV=production exige https en las URLs y correo real, y sirve la consola y el
# chat compilados desde la API, cada uno en su dominio (CONSOLE_URL y CHAT_PUBLIC_URL).
# En producción BETTER_AUTH_URL puede omitirse: es el dominio de la consola.
NODE_ENV=
# Correo: "log" (desarrollo, al log del servidor) o "postmark"
EMAIL_PROVIDER=log
POSTMARK_SERVER_TOKEN=
EMAIL_FROM=                      # "HablaHora <no-reply@tu-dominio.com>" (firma verificada en Postmark)
# Monitoreo de errores (Sentry); vacío = apagado. Lo usan la API y las dos apps.
SENTRY_DSN=
SENTRY_ENVIRONMENT=              # staging | production (por defecto, NODE_ENV)
# Avanzado: SERVE_STATIC=true|false (por defecto, true en producción) y
# TRUST_PROXY=<saltos de proxy delante de la API> (por defecto, 1 en producción)
